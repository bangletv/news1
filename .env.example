# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# INGEST_HMAC_SECRET: Server-only secret for signing /api/v1/internal/ingest payloads.
INGEST_HMAC_SECRET="CHANGE_ME_IN_PRODUCTION"

# INDEXNOW_KEY: Optional IndexNow API key for Bing/Yandex/Naver/Seznam URL submission.
INDEXNOW_KEY=""

# FB_PAGE_TOKEN: Optional official Facebook Page API token (server-only).
FB_PAGE_TOKEN=""
