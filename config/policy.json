  "exclusions": [
    {
      "id": "gambling",
      "label": "Lottery and gambling",
      "severity": "hard",
      "patterns": [
        "lottery", "lotto", "jackpot", "powerball", "mega millions", "casino*",
        "gambling", "sports betting", "sportsbook", "bookmaker*",
        "betting tips", "slot machine*", "online poker", "bingo"
      ]
    },
    {
      "id": "adult_explicit",
      "label": "Explicit adult content",
      "severity": "hard",
      "patterns": ["xxx", "onlyfans", "nsfw", "sex tape*", "adult film*"]
    },
    {
      "id": "adult_news",
      "label": "Adult content (reporting may be exempt)",
      "severity": "soft",
      "patterns": ["porn*", "erotic*", "sex scandal*", "sexual content"]
    },
    {
      "id": "clickbait",
      "label": "Sensational clickbait",
      "severity": "soft",
      "patterns": [
        "you won't believe", "will shock you", "shocking", "jaw-dropping",
        "what happened next", "this one weird trick", "gone viral",
        "goes viral", "you need to see", "doctors hate",
        "will blow your mind", "mind-blowing", "unbelievable"
      ]
    },
    {
      "id": "gratuitous_violence",
      "label": "Gratuitous violence and bloodshed",
      "severity": "soft",
      "patterns": [
        "gruesome", "grisly", "bloodbath", "blood-soaked", "mutilat*",
        "decapitat*", "graphic footage", "graphic video", "dismember*",
        "bloodshed"
      ]
    },
    {
      "id": "crime_sensationalism",
      "label": "Crime sensationalism",
      "severity": "soft",
      "patterns": [
        "serial killer", "true crime", "killer clown", "horrific murder",
        "caught on camera", "caught on video"
      ]
    },
    {
      "id": "war_fear",
      "label": "War-fear manipulation",
      "severity": "soft",
      "patterns": [
        "world war 3", "world war iii", "third world war",
        "nuclear apocalypse", "doomsday", "end of the world"
      ]
    },
    {
      "id": "rumours",
      "label": "Rumours",
      "severity": "soft",
      "patterns": [
        "rumour*", "rumor*", "unconfirmed reports", "fans speculate",
        "insiders claim", "leaked photos"
      ]
    },
    {
      "id": "gossip",
      "label": "Irrelevant gossip",
      "severity": "soft",
      "patterns": [
        "celebrity", "celebrities", "red carpet", "wardrobe malfunction",
        "net worth", "baby bump", "dating rumo*", "spotted with",
        "reality star*", "kardashian*"
      ]
    },
    {
      "id": "propaganda_sources",
      "label": "Sources flagged as propaganda risk",
      "severity": "hard",
      "sourceFlags": ["propaganda_risk", "state_propaganda"]
    }
  ],
  "publicInterest": {
    "exemptMaxTrustTier": 2,
    "note": "Soft exclusions are waived when the source is trust tier <= exemptMaxTrustTier AND the headline matches at least one priority topic. Hard exclusions are never waived."
  },
  "publishing": {
    "allowHttp": false,
    "headlineMinChars": 10,
    "headlineMaxChars": 300,
    "allowMissingDate": true,
    "maxFutureHours": 24,
    "maxAgeDays": 90,
    "maxAgeDaysBySourceClass": {
      "government": 365,
      "university_research": 365,
      "international_org": 180
    },
    "requireClassification": true
  },
  "dedupe": {
    "sameSourceTitleWindowHours": 72,
    "crossSource": "allow",
    "nearDuplicateThreshold": 0.85,
    "nearDuplicateWindowHours": 48
  },
  "limits": {
    "maxItemsPerEndpointPerRun": 300,
    "maxPublishedPerSourcePerDay": 500,
    "fetchTimeoutMs": 15000,
    "minIntervalMsPerHost": 1000,
    "maxFeedBytes": 5000000,
    "maxEndpointsPerRun": 1000
  },
  "retention": {
    "exclusionsMax": 50000,
    "exceptionsMax": 20000
  },
  "integrity": {
    "maxRedirects": 5,
    "maxPageBytes": 262144,
    "matchThreshold": 0.7,
    "mismatchThreshold": 0.35,
    "definitiveStatuses": [404, 410],
    "suspendAfterConsecutiveFailures": 3,
    "ambiguousChecksBeforeSuspend": 3,
    "restoreAfterConsecutiveOk": 2,
    "removeAfterDaysSuspended": 14,
    "recheckHours": {
      "verified": 24,
      "unverifiable": 72,
      "suspended": 6
    },
    "recheckMinutes": {
      "under_watch": 30
    },
    "softNotFoundPhrases": [
      "page not found", "404 not found", "error 404",
      "page cannot be found", "no longer available",
      "this page doesn't exist", "we couldn't find that page",
      "page you requested"
    ]
  },
